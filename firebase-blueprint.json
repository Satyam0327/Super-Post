{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and usage data",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "plan": { "type": "string", "enum": ["free", "pro"] },
        "jobsUsed": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "plan", "jobsUsed", "createdAt"]
    },
    "Job": {
      "title": "Job",
      "description": "A content repurposing job",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 100000 },
        "contentType": { "type": "string" },
        "results": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "contentType", "createdAt"]
    },
    "TranscriptCache": {
      "title": "TranscriptCache",
      "description": "Global cache for YouTube transcripts to save API calls",
      "type": "object",
      "properties": {
        "videoId": { "type": "string", "maxLength": 50 },
        "transcript": { "type": "string", "maxLength": 500000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["videoId", "transcript", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Users collection"
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "Jobs collection"
    },
    "/transcripts/{videoId}": {
      "schema": { "$ref": "#/entities/TranscriptCache" },
      "description": "Global transcript cache"
    }
  }
}
