rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'plan', 'jobsUsed', 'createdAt'])
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 200
        && data.plan is string
        && data.jobsUsed is number
        && data.createdAt is string;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) 
        && isValidUser(incoming())
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['jobsUsed', 'plan'])
        );
      allow delete: if false;
    }

    function isValidJob(data) {
      return data.keys().hasAll(['userId', 'createdAt', 'contentType'])
        && data.userId == request.auth.uid
        && data.createdAt is string
        && data.contentType is string;
    }

    match /jobs/{jobId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(jobId) && isValidJob(incoming());
      allow update: if isSignedIn() && isValidId(jobId) && resource.data.userId == request.auth.uid
        && isValidJob(incoming());
      allow delete: if isSignedIn() && isValidId(jobId) && resource.data.userId == request.auth.uid;
    }

    function isValidTranscript(data) {
      return data.keys().hasAll(['videoId', 'transcript', 'createdAt'])
        && data.videoId is string && data.videoId.size() <= 50
        && data.transcript is string && data.transcript.size() <= 500000
        && data.createdAt is string;
    }

    match /transcripts/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(videoId) && isValidTranscript(incoming());
      allow update: if false; // Transcripts are immutable
      allow delete: if false;
    }
  }
}
